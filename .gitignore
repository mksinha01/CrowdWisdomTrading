# Recorded API responses MAY contain your token in a URL — keep them out
# until scripts/scrub_fixtures.py has run. (The recorder scrubs on write;
# this is belt-and-braces.)
fixtures/http/**/*.raw.json

# Hermes local state
.hermes/
*.log